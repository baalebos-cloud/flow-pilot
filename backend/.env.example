FLOWPILOT_ENV=development
FLOWPILOT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite+pysqlite:///flowpilot.db

# Keep mock mode on until the team confirms BMONI's real base URL and schemas.
BMONI_MODE=mock
BMONI_BASE_URL=
BMONI_API_KEY=
BMONI_WEBHOOK_SECRET=

# Application-layer safety limits. An API gateway should enforce an additional
# distributed limit in deployed environments.
AUTH_RATE_LIMIT_PER_MINUTE=10
FINANCIAL_RATE_LIMIT_PER_MINUTE=30
